# Copy to .env (or set in your hosting environment). All are required when NODE_ENV=production.
# In local development, missing values are generated once into .data/dev-secrets.json.

PORT=8787
# Real Postgres. Leave empty to use the embedded database in .data/pglite.
DATABASE_URL=
# 32 random bytes, base64. Encrypts names, dates of birth and notes at rest. Never change it without re-encrypting.
DATA_ENCRYPTION_KEY=
# Signs staff sessions.
SESSION_SECRET=
# Access codes for the staff consoles. Replace with institution SSO before launch.
MENTOR_ACCESS_CODE=
ADMIN_ACCESS_CODE=
# Shared key the course platform (LMS) sends as X-Platform-Key on POST /v1/learners/{id}/events.
COURSE_PLATFORM_KEY=
